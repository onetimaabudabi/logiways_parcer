{
  "permissions": {
    "allow": [
      "Bash(python *)",
      "Bash(ls -la *.py)",
      "Bash(python3)",
      "Bash(python3 -c \"import json; f = open\\('openapi.json'\\); spec = json.load\\(f\\); paths = [p for p in spec['paths'].keys\\(\\) if 'admin' in p or 'location' in p]; print\\('\\\\n'.join\\(sorted\\(paths\\)[:20]\\)\\)\")",
      "Bash(find . -name \"*.py\" -type f -exec grep -l \"upload\\\\|fill_location\\\\|send_api\" {} \\\\;)"
    ],
    "deny": [
      "Read(.env*)",
      "Read(**/credentials*)",
      "Bash(rm -rf:*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "enableAllProjectMcpServers": true,
  "language": "russian",
  "alwaysThinkingEnabled": false,
  "autoUpdatesChannel": "stable"
}
